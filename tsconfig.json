{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-build/types/**/*.ts",
    ".next-button-blend/types/**/*.ts",
    ".next-compact/types/**/*.ts",
    ".next-preview/types/**/*.ts",
    ".next-scene-production/types/**/*.ts",
    ".next-scene-review/types/**/*.ts",
    ".next-ux-audit/types/**/*.ts",
    ".next-visual-repair/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-ux-review-final/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
